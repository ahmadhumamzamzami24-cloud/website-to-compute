<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Tic Tac Toe — 2 Player</title>
  <style>
    :root{
      --bg1:#0f172a; /* dark navy */
      --bg2:#0b1220;
      --card:#0b1228;
      --accent:#4ade80; /* green */
      --accent2:#60a5fa; /* blue */
      --glass: rgba(255,255,255,0.04);
      --muted:rgba(255,255,255,0.6);
      --glass-2: rgba(255,255,255,0.03);
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;font-family:Inter,ui-sans-serif,system-ui,Helvetica,Arial;
      background: radial-gradient(1200px 600px at 10% 20%, rgba(96,165,250,0.08), transparent),
                  radial-gradient(900px 400px at 90% 80%, rgba(74,222,128,0.06), transparent),
                  linear-gradient(180deg,var(--bg1),var(--bg2));
      color:#e6eef8;display:flex;align-items:center;justify-content:center;padding:24px;
    }
    .container{
      width:100%;max-width:920px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border-radius:18px;padding:18px;box-shadow:0 10px 30px rgba(2,6,23,0.6);backdrop-filter: blur(6px);
      display:grid;grid-template-columns:360px 1fr;gap:18px;align-items:center;
    }

    /* Left panel */
    .panel{background:var(--card);border-radius:14px;padding:18px}
    h1{font-size:20px;margin:0 0 6px}
    p.small{color:var(--muted);margin:0 0 12px;font-size:13px}

    .scoreboard{display:flex;gap:12px;margin-bottom:12px}
    .score{flex:1;background:var(--glass);padding:12px;border-radius:12px;text-align:center;}
    .score strong{display:block;font-size:20px}
    .turn-indicator{display:flex;align-items:center;gap:10px;margin-bottom:12px}
    .dot{width:14px;height:14px;border-radius:50%;background:linear-gradient(135deg,var(--accent2),var(--accent));box-shadow:0 4px 12px rgba(96,165,250,0.15);}
    .controls{display:flex;gap:10px}
    button.btn{background:linear-gradient(135deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.04);color:inherit;padding:10px 12px;border-radius:10px;cursor:pointer}
    button.primary{background:linear-gradient(90deg,var(--accent),var(--accent2));color:#05203b;font-weight:700;border:none}

    /* Board */
    .board-wrap{display:flex;flex-direction:column;gap:12px;align-items:center}
    .board{width:min(68vw,420px);aspect-ratio:1;background:linear-gradient(180deg,var(--glass),var(--glass-2));border-radius:16px;padding:14px;display:grid;grid-template-columns:repeat(3,1fr);grid-gap:12px;}
    .cell{background:transparent;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:42px;font-weight:900;cursor:pointer; user-select:none;position:relative;overflow:hidden}
    .cell::before{content:'';position:absolute;inset:0;border-radius:12px;transition:transform .28s cubic-bezier(.2,.9,.3,1);transform:scale(0);background:linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));}
    .cell:hover::before{transform:scale(1)}
    .mark{transform-origin:center;display:inline-block;transition:transform .36s cubic-bezier(.2,.9,.3,1),opacity .28s;opacity:0;}
    .mark.show{opacity:1;transform:scale(1) rotate(0deg)}
    .mark.x{color: #ffd166; text-shadow:0 6px 18px rgba(255,209,102,0.08)}
    .mark.o{color:#60a5fa}

    /* initially shrink marks when added */
    .mark.added{transform:scale(0.05) rotate(-20deg)}

    /* winning line overlay */
    .overlay{position:absolute;inset:0;pointer-events:none}
    svg.line{position:absolute;left:0;top:0;width:100%;height:100%;overflow:visible}
    path.win{stroke:rgba(250,204,21,0.95);stroke-width:10;stroke-linecap:round;fill:none;stroke-dasharray:1000;stroke-dashoffset:1000;filter:drop-shadow(0 10px 20px rgba(250,204,21,0.12));}

    /* modal */
    .modal{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) scale(0.9);opacity:0;min-width:280px;background:linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));border-radius:14px;padding:16px;box-shadow:0 20px 50px rgba(2,6,23,0.6);transition:all .28s ease;z-index:40}
    .modal.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
    .modal h2{margin:0 0 6px}
    .modal p{margin:0 0 12px;color:var(--muted)}

    /* footer small */
    .meta{font-size:12px;color:var(--muted);margin-top:10px;text-align:center}

    /* responsive */
    @media (max-width:820px){
      .container{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="panel">
      <h1>Tic Tac Toe — 2 Pemain</h1>
      <p class="small">Bermain bergantian. Kemenangan otomatis menampilkan garis kemenangan & animasi.</p>

      <div class="scoreboard">
        <div class="score">
          <div style="font-size:12px">Player X</div>
          <strong id="scoreX">0</strong>
        </div>
        <div class="score">
          <div style="font-size:12px">Player O</div>
          <strong id="scoreO">0</strong>
        </div>
        <div class="score">
          <div style="font-size:12px">Seri</div>
          <strong id="scoreT">0</strong>
        </div>
      </div>

      <div class="turn-indicator">
        <div class="dot" id="turnDot"></div>
        <div>
          <div style="font-size:13px">Giliran</div>
          <div id="turnText" style="font-weight:700">X</div>
        </div>
      </div>

      <div class="controls">
        <button class="btn" id="resetBtn">Reset Skor</button>
        <button class="btn primary" id="newBtn">Main Baru</button>
      </div>

      <div class="meta">Responsive • Animasi saat menandai • Untuk 2 pemain (satu perangkat)</div>
    </div>

    <div class="board-wrap">
      <div style="position:relative; width:100%;max-width:520px;">
        <div class="board" id="board">
          <!-- 9 cells injected by JS -->
        </div>
        <div class="overlay" id="overlay"></div>
      </div>

      <div style="display:flex;gap:10px;align-items:center">
        <div style="font-size:13px;color:var(--muted)">Petunjuk:</div>
        <div style="font-size:13px;color:var(--muted)">Tap/klik sel untuk menandai.</div>
      </div>
    </div>
  </div>

  <!-- modal -->
  <div class="modal" id="modal" role="dialog" aria-hidden="true">
    <h2 id="modalTitle">Pemenang!</h2>
    <p id="modalText">Player X menang 🎉</p>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button class="btn" id="modalClose">Tutup</button>
      <button class="btn primary" id="modalNext">Main Lagi</button>
    </div>
  </div>

  <script>
    // Game state
    const boardEl = document.getElementById('board');
    const overlay = document.getElementById('overlay');
    const turnText = document.getElementById('turnText');
    const turnDot = document.getElementById('turnDot');
    const scoreX = document.getElementById('scoreX');
    const scoreO = document.getElementById('scoreO');
    const scoreT = document.getElementById('scoreT');
    const modal = document.getElementById('modal');
    const modalTitle = document.getElementById('modalTitle');
    const modalText = document.getElementById('modalText');

    let grid = Array(9).fill('');
    let turn = 'X';
    let playing = true;
    let scores = {X:0,O:0,T:0};

    const winCombos = [
      [0,1,2],[3,4,5],[6,7,8],
      [0,3,6],[1,4,7],[2,5,8],
      [0,4,8],[2,4,6]
    ];

    // initialize board
    function createBoard(){
      boardEl.innerHTML = '';
      grid = Array(9).fill('');
      for(let i=0;i<9;i++){
        const cell = document.createElement('div');
        cell.className = 'cell';
        cell.dataset.idx = i;
        cell.addEventListener('click', onCellClick);
        boardEl.appendChild(cell);
      }
      clearOverlay();
      playing = true;
      turn = 'X';
      updateTurnUI();
    }

    function updateTurnUI(){
      turnText.textContent = turn;
      if(turn==='X'){
        turnDot.style.background = 'linear-gradient(135deg,var(--accent),var(--accent2))';
      } else {
        turnDot.style.background = 'linear-gradient(135deg,var(--accent2),var(--accent))';
      }
    }

    function onCellClick(e){
      const idx = +e.currentTarget.dataset.idx;
      if(!playing || grid[idx]) return;
      placeMark(idx,turn);
      const winner = checkWinner();
      if(winner){
        playing=false;
        handleWin(winner);
        return;
      }
      if(grid.every(Boolean)){
        // draw
        playing=false;
        scores.T++;
        scoreT.textContent = scores.T;
        showModal('Seri', 'Tidak ada pemenang — seri.');
        confettiBurst();
        return;
      }
      // switch
      turn = turn === 'X' ? 'O' : 'X';
      updateTurnUI();
    }

    function placeMark(idx, who){
      grid[idx] = who;
      const cell = boardEl.children[idx];
      const span = document.createElement('span');
      span.className = 'mark added ' + (who==='X' ? 'x' : 'o');
      span.textContent = who;
      cell.appendChild(span);

      // force reflow to animate from small -> show
      requestAnimationFrame(()=>{
        span.classList.remove('added');
        span.classList.add('show');
      });
    }

    function checkWinner(){
      for(const combo of winCombos){
        const [a,b,c] = combo;
        if(grid[a] && grid[a]===grid[b] && grid[a]===grid[c]){
          return {who:grid[a],combo};
        }
      }
      return null;
    }

    function handleWin(res){
      const who = res.who;
      // update score
      scores[who]++;
      if(who==='X') scoreX.textContent = scores.X; else scoreO.textContent = scores.O;

      // draw animated line using SVG
      drawWinLine(res.combo);

      // show modal after short delay
      setTimeout(()=>{
        showModal('Pemenang!', `Player ${who} menang 🎉`);
        confettiBurst();
      }, 520);
    }

    function clearOverlay(){
      overlay.innerHTML = '';
    }

    function drawWinLine(combo){
      clearOverlay();
      const svgNS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(svgNS,'svg');
      svg.classList.add('line');
      // compute coordinates relative to boardEl
      const rect = boardEl.getBoundingClientRect();
      const cellRect = boardEl.children[0].getBoundingClientRect();
      const gapX = (boardEl.clientWidth - (cellRect.width*3)) / 2; // approx
      const coords = combo.map(i => {
        const c = boardEl.children[i].getBoundingClientRect();
        const x = c.left - rect.left + c.width/2;
        const y = c.top - rect.top + c.height/2;
        return {x,y};
      });
      const path = document.createElementNS(svgNS,'path');
      path.classList.add('win');
      const d = `M ${coords[0].x} ${coords[0].y} L ${coords[2].x} ${coords[2].y}`;
      path.setAttribute('d',d);
      svg.appendChild(path);
      overlay.appendChild(svg);

      // animate stroke dashoffset
      setTimeout(()=>{
        path.style.transition = 'stroke-dashoffset 700ms cubic-bezier(.2,.9,.3,1)';
        path.style.strokeDashoffset = '0';
      },50);
    }

    // modal control
    document.getElementById('modalClose').addEventListener('click', ()=>{
      modal.classList.remove('show');
    });
    document.getElementById('modalNext').addEventListener('click', ()=>{
      modal.classList.remove('show');
      createBoard();
    });

    document.getElementById('newBtn').addEventListener('click', ()=>{
      createBoard();
    });
    document.getElementById('resetBtn').addEventListener('click', ()=>{
      scores = {X:0,O:0,T:0};scoreX.textContent='0';scoreO.textContent='0';scoreT.textContent='0';
      createBoard();
    });

    function showModal(title,text){
      modalTitle.textContent = title;
      modalText.textContent = text;
      modal.classList.add('show');
    }

    // small confetti implementation
    function confettiBurst(){
      const c = document.createElement('canvas');
      c.style.position='fixed';c.style.left=0;c.style.top=0;c.style.width='100%';c.style.height='100%';c.style.pointerEvents='none';c.style.zIndex=60;
      document.body.appendChild(c);
      c.width = innerWidth; c.height = innerHeight;
      const ctx = c.getContext('2d');
      const particles = [];
      const colors = ['#FFD166','#60A5FA','#34D399','#F87171','#A78BFA'];
      for(let i=0;i<80;i++){
        particles.push({x:innerWidth/2 + (Math.random()-0.5)*200,y:innerHeight/2 + (Math.random()-0.5)*200, vx:(Math.random()-0.5)*8, vy:(Math.random()-4)*8, r:2+Math.random()*4, c:colors[Math.floor(Math.random()*colors.length)], life:60+Math.random()*40});
      }
      function step(){
        ctx.clearRect(0,0,c.width,c.height);
        for(let p of particles){
          p.x += p.vx; p.y += p.vy; p.vy += 0.25; p.life--;
          ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fillStyle=p.c; ctx.fill();
        }
        // remove dead
        for(let i=particles.length-1;i>=0;i--) if(particles[i].life<=0) particles.splice(i,1);
        if(particles.length>0) requestAnimationFrame(step); else c.remove();
      }
      step();
    }

    // initial
    createBoard();

    // handle resize: redraw overlay when window changes
    let resizeTO;
    window.addEventListener('resize', ()=>{
      clearTimeout(resizeTO); resizeTO = setTimeout(()=>{ if(!playing){ /* if overlay exists, recompute using current combo if any */ }
        clearOverlay();
      },220);
    });

    // accessibility: keyboard support
    window.addEventListener('keydown',(e)=>{
      if(!playing) return;
      // number keys 1-9 map to cells
      const k = e.key;
      if(/^[1-9]$/.test(k)){
        const idx = parseInt(k,10)-1; // user might expect 1->0
        if(boardEl.children[idx]) boardEl.children[idx].click();
      }
    });
  </script>
</body>
</html>
